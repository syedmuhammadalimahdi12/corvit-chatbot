# --- Required: LLM provider (OpenAI-compatible chat completions API) ---
# Default provider is Groq, which hosts gpt-oss-120b for free with generous limits.
# Get a key at https://console.groq.com/keys
LLM_API_KEY=

# Change these three only if you want to use a different OpenAI-compatible
# provider (OpenRouter, Together AI, Fireworks, etc.) instead of Groq.
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Optional: "online search" feature (sketch point 2) ---
# If set, the chatbot will search the live web when your local knowledge
# base has no confident match. Get a free key at https://tavily.com
TAVILY_API_KEY=
